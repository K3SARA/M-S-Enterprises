{
  "name": "offline-distributor-management",
  "version": "1.0.0",
  "description": "Offline-first Apple-inspired Desktop Distributor Management Application",
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:server": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:vite": "node node_modules/vite/bin/vite.js --host",
    "dev:electron": "node node_modules/electron/cli.js .",
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -k -n \"SERVER,VITE\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:vite\"",
    "build:electron": "node node_modules/typescript/bin/tsc -p tsconfig.electron.json",
    "build:server": "node node_modules/esbuild/bin/esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist-server/index.js --external:@prisma/client --external:prisma",
    "build:vite": "node node_modules/vite/bin/vite.js build",
    "build": "node scripts/prepare-prisma.js && node node_modules/vite/bin/vite.js build && node node_modules/prisma/build/index.js generate",
    "build:all": "node scripts/prepare-prisma.js && node node_modules/vite/bin/vite.js build && node node_modules/prisma/build/index.js generate && npm run build:electron && npm run build:server",
    "dist:win": "node scripts/prepare-prisma.js && npm run build:vite && npm run build:electron && npm run build:server && node node_modules/electron-builder/cli.js --win --x64",
    "start": "node scripts/prepare-prisma.js && node node_modules/prisma/build/index.js db push --accept-data-loss && node node_modules/tsx/dist/cli.mjs server/index.ts",
    "start:electron": "node node_modules/cross-env/src/bin/cross-env.js NODE_ENV=production node node_modules/electron/cli.js .",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev --name init",
    "prisma:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:wipe": "node scripts/wipe-data.js",
    "use:postgres": "node -e \"require('fs').copyFileSync('prisma/schema.postgresql.prisma', 'prisma/schema.prisma')\" && prisma generate",
    "use:sqlite": "node -e \"require('fs').writeFileSync('prisma/schema.prisma', require('fs').readFileSync('prisma/schema.prisma', 'utf8').replace(/provider = \\\"postgresql\\\"/, 'provider = \\\"sqlite\\\"'))\" && prisma generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.msenterprises.distributor",
    "productName": "M&S Enterprises",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "dist-server/**/*",
      "prisma/distributor.db",
      "prisma/schema.prisma",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@prisma/**/*",
      "**/node_modules/.prisma/**/*",
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "M&S Enterprises"
    }
  }
}
